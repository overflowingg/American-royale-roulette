rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayer(data) {
      return data.uid is string && isValidId(data.uid) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 64 &&
             data.chips is number &&
             data.isManager is bool;
    }

    function isValidBet(data) {
      return data.id is string && isValidId(data.id) &&
             data.playerUid is string && isValidId(data.playerUid) &&
             data.playerName is string && data.playerName.size() >= 1 &&
             data.amount is number && data.amount > 0 &&
             data.value is string;
    }

    // Players collection: unique document per participant/manager
    match /players/{uid} {
      allow get, list: if true;
      allow create: if isValidId(uid) && isValidPlayer(request.resource.data);
      allow update: if isValidId(uid) && isValidPlayer(request.resource.data);
      allow delete: if isValidId(uid);
    }

    // Bets collection: trial records permanently recorded
    match /bets/{betId} {
      allow get, list: if true;
      allow create: if isValidId(betId) && isValidBet(request.resource.data);
      allow update: if isValidId(betId);
      allow delete: if isValidId(betId);
    }

    // Games collection: spin outcomes
    match /games/{gameId} {
      allow get, list: if true;
      allow create: if isValidId(gameId) && request.resource.data.winningNumber is string;
      allow update: if false;
      allow delete: if false;
    }

    // Synthetic Gambler's Fallacy research datasets
    match /synthetic_trials/{id} {
      allow read, write: if true;
    }

    match /synthetic_participants/{id} {
      allow read, write: if true;
    }
  }
}
